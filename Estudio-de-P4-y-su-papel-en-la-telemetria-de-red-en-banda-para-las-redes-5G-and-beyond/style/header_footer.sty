\ProvidesPackage{header_footer}

\usepackage{fancyhdr}

\pagestyle{fancy}
\fancyhf{}

% Configuración del encabezado
\fancyhead[L]{\scriptsize\leftmark}
\fancyhead[R]{\scriptsize\thepage}

% Línea divisoria debajo del encabezado
\renewcommand{\headrulewidth}{0.4pt}

% Altura del encabezado
\setlength{\headheight}{5.5pt}

% Personalización del formato de capítulo en el encabezado
\renewcommand{\chaptermark}[1]{%
  \markboth{\MakeUppercase{Capítulo \thechapter. #1}}{}%
}

% Personalización del formato de sección en el encabezado (opcional)
\renewcommand{\sectionmark}[1]{%
  \markright{\MakeUppercase{\thesection. #1}}{}%
}
