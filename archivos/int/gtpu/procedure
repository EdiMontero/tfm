'SW3 int-gtp-destination Configuration (Sink)'
---------------------------------------------------------------------------
# Connect to SW3
simple_switch_CLI --thrift-port 9092

# Clear existing tables
table_clear MyIngress.ipv4_lpm
table_clear MyIngress.int_sink_table
table_clear MyEgress.egress_control

# Add forwarding rules
# To AMF (is on port 1)
table_add MyIngress.ipv4_lpm forward_action 172.18.0.20/32 => 1
# To UPF (is on port 1) 
table_add MyIngress.ipv4_lpm forward_action 172.18.0.24/32 => 1
# To gNB/RAN (back to SW2 on port 2)
table_add MyIngress.ipv4_lpm forward_action 172.18.10.3/32 => 2
# Default route (to destination hosts)
table_add MyIngress.ipv4_lpm forward_action 0.0.0.0/0 => 1

# Add INT sink rule - activate cloning for INT packets (key: int_shim.isValid() = 1)
table_add MyIngress.int_sink_table int_sink_action 1 =>

# Add egress control to strip INT headers when forwarding to destination hosts (port 1)
table_add MyEgress.egress_control strip_int_headers 1 =>

# Configure mirroring session 99 to send cloned packets to port 9 (INT collector)
mirroring_add 99 9

# Verify tables
table_dump MyIngress.ipv4_lpm
table_dump MyIngress.int_sink_table
table_dump MyEgress.egress_control

# Verify mirroring configuration
mirroring_get 99

